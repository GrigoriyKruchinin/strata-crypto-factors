# Strata — example environment. Copy to `.env` and adjust. Never commit `.env`.
# Only public market data is used: no exchange API keys are needed or read.

# --- App ---
APP_LOG_LEVEL=INFO

# --- Local database (SQLite file; created automatically) ---
DB_URL=sqlite+aiosqlite:///data/strata.db

# --- Data ---
DATA_ROOT_DIR=data
DATA_HISTORY_START=2020-01-01
DATA_DOWNLOAD_CONCURRENCY=16

# --- Research ---
RESEARCH_TRAIN_START=2020-01-01
RESEARCH_TRAIN_END=2023-12-31
RESEARCH_HOLDOUT_START=2024-01-01
RESEARCH_RANDOM_SIGNAL_RUNS=1000
RESEARCH_WORKERS=4

# --- Paper simulation ---
PAPER_ACCOUNT=paper
PAPER_INITIAL_EQUITY=3000

# --- Telegram (optional analytics reports) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
