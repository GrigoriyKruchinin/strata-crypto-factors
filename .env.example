# Strata — example environment. Copy to `.env` and fill in. Never commit `.env`.

# --- App ---
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_TIMEZONE=UTC

# --- Database (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=strata
DB_USER=strata
DB_PASSWORD=change-me

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Exchange (Stage 1: public data only, no keys needed) ---
EXCHANGE_NAME=binance_usdm
EXCHANGE_TESTNET=false
# Stage 2 only. Trade-only key, NO withdrawal permission, IP-whitelisted.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- Research periods ---
RESEARCH_TRAIN_START=2020-01-01
RESEARCH_TRAIN_END=2023-12-31
RESEARCH_HOLDOUT_START=2024-01-01

# --- Universe / portfolio ---
UNIVERSE_TOP_N=50
UNIVERSE_VOLUME_LOOKBACK_DAYS=30
PORTFOLIO_REBALANCE=weekly
PORTFOLIO_POSITIONS_PER_SIDE=10
PORTFOLIO_CAPITAL_USDT=3000

# --- Risk ---
RISK_MAX_GROSS_LEVERAGE=2.0
RISK_MAX_DRAWDOWN=0.25
RISK_MAX_COIN_WEIGHT=0.15

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard (Stage 3) ---
DASHBOARD_ADMIN_USER=
DASHBOARD_ADMIN_PASSWORD=
